<?xml version="1.0"?>
<PLUGIN name="corsairpsu" author="shiftylilbastrd" version="2026.11.08" icon="icon-ups" launch="Settings/CorsairPSUSettings" pluginURL="https://raw.githubusercontent.com/shiftylilbastrd/Unraid-plugins/main/corsairpsu/corsairpsu.plg" min="6.12.0">
  <CHANGES>
  ### 2026.11.08
  - Restores Unraid's native tile header controls for expand/collapse and settings.
  - Keeps the RMi/HXi 12V rail under a stable 12V label when its measured voltage varies.
  - Adds the missing uptime and total-runtime row.
  </CHANGES>
  <FILE Name="/boot/config/plugins/corsairpsu/corsairpsu-2025.11.23-x86_64.txz" Run="upgradepkg --install-new">
    <URL>https://raw.githubusercontent.com/giganode/corsairpsu-unraid/master/pkg/corsairpsu-2025.11.23-x86_64.txz</URL>
    <MD5>d65b56a21cdad9d491c8e795392acc53</MD5>
  </FILE>
  <FILE Run="/bin/bash">
    <INLINE><![CDATA[
set -eu
plugdir="/usr/local/emhttp/plugins/corsairpsu"
mkdir -p "$plugdir"
printf '%s' '' | base64 -d > "$plugdir/statusMovable.page"
printf '%s' '' | base64 -d > "$plugdir/status.php"
    ]]></INLINE>
  </FILE>
  <FILE Run="/bin/bash" Method="remove">
    <INLINE><![CDATA[
removepkg /boot/config/plugins/corsairpsu/*.txz
rm -rf /boot/config/plugins/corsairpsu
rm -rf /usr/local/emhttp/plugins/corsairpsu
    ]]></INLINE>
  </FILE>
</PLUGIN>
