Menu="Buttons"
Name="CPU Tile Summary"
---
<style>
.cpu-tile-summary {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  flex-wrap: nowrap;
  white-space: nowrap;
  font-size: 12px;
  line-height: 18px;
}
.cpu-tile-summary[hidden] { display: none !important; }
.cpu-tile-summary .cpu-summary-item { white-space: nowrap; }
.cpu-tile-summary [data-metric] { font-variant-numeric: tabular-nums; }
.cpu-tile-summary .cpu-summary-load { display: inline-flex; align-items: center; gap: 5px; }
.cpu-tile-summary .cpu-summary-bar {
  display: inline-block;
  width: 50px;
  height: 10px;
  background: rgba(128,128,128,.22);
  vertical-align: middle;
}
.cpu-tile-summary .cpu-summary-fill {
  display: block;
  height: 100%;
  width: 0;
  background: #8a8a8a;
  transition: width .4s ease;
}
</style>
<script>
(function () {
  'use strict';
  var timer = null;
  var modelDescription = null;

  function findCpuTile() {
    var icon = document.querySelector('i.icon-cpu');
    return icon ? icon.closest('tbody') : null;
  }

  function ensureDescription(section) {
    if (modelDescription && modelDescription.isConnected) return modelDescription;
    modelDescription = section.querySelector('.cpu-model-description');
    if (modelDescription) return modelDescription;
    var heading = section.querySelector('h3.tile-header-main');
    if (!heading) return null;
    var node = heading.nextSibling;
    while (node && !(node.nodeType === Node.TEXT_NODE && node.textContent.trim())) node = node.nextSibling;
    if (!node) return null;
    modelDescription = document.createElement('span');
    modelDescription.className = 'cpu-model-description';
    modelDescription.textContent = node.textContent.trim();
    node.parentNode.replaceChild(modelDescription, node);

    var summary = document.createElement('span');
    summary.className = 'cpu-tile-summary';
    summary.innerHTML = '<span class="cpu-summary-item"><span class="cpu-summary-icon cpu-summary-power-icon"></span> Total Power: <span data-metric="power">—</span></span>' +
      '<span class="cpu-summary-item"><span class="cpu-summary-icon cpu-summary-temperature-icon"></span> Temperature: <span data-metric="temperature">—</span></span>' +
      '<span class="cpu-summary-item cpu-summary-load">Overall Load: <span data-metric="load">—</span>' +
      '<span class="cpu-summary-bar"><span class="cpu-summary-fill"></span></span></span>';
    modelDescription.parentNode.insertBefore(summary, modelDescription);
    return modelDescription;
  }

  function copyNativeIcons(tile, summary) {
    var powerTarget = summary.querySelector('.cpu-summary-power-icon');
    if (!powerTarget.firstChild) {
      var nativePowerIcon = tile.querySelector('#cpu-total-power i.fa-plug');
      if (nativePowerIcon) powerTarget.appendChild(nativePowerIcon.cloneNode(true));
    }

    var temperatureTarget = summary.querySelector('.cpu-summary-temperature-icon');
    if (!temperatureTarget.firstChild) {
      var temperatureValue = tile.querySelector('#cpu-temp0, [id^="cpu-temp"]');
      var nativeTemperatureIcon = temperatureValue && temperatureValue.closest('.head_info, tr, td')
        ? temperatureValue.closest('.head_info, tr, td').querySelector('i.fa-thermometer')
        : null;
      if (!nativeTemperatureIcon) nativeTemperatureIcon = tile.querySelector('i.fa-thermometer');
      if (nativeTemperatureIcon) temperatureTarget.appendChild(nativeTemperatureIcon.cloneNode(true));
    }
  }

  function removeUnexpectedHeaderIcons(section, summary) {
    // The Processor header has no icon of its own; keep only the native metric icons inside the summary.
    var icons = section.querySelectorAll('i, svg, [class*="icon-"], [class*="fa-"], [data-icon]');
    for (var i = 0; i < icons.length; i++) {
      if (!summary.contains(icons[i])) icons[i].remove();
    }
  }

  function metricText(selector) {
    var element = document.querySelector(selector);
    return element ? element.textContent.trim() : '';
  }

  function update() {
    if (document.hidden) return;
    var tile = findCpuTile();
    if (!tile) return;
    var section = tile.querySelector('i.icon-cpu').parentElement.querySelector('div.section');
    if (!section) return;
    var description = ensureDescription(section);
    if (!description) return;
    var summary = section.querySelector('.cpu-tile-summary');
    removeUnexpectedHeaderIcons(section, summary);
    copyNativeIcons(tile, summary);

    // The Dashboard's own chevron indicates whether the Processor tile body is collapsed.
    var toggle = tile.querySelector('.openclose');
    var collapsed = !!(toggle && toggle.classList.contains('fa-chevron-down'));
    summary.hidden = !collapsed;
    description.hidden = collapsed;
    if (!collapsed) return;

    // Reuse Unraid's live values so units and hardware support match the expanded tile.
    var powerText = metricText('#cpu-total-power');
    var powerMatch = powerText.match(/:\s*(.+)$/);
    var temperature = metricText('#cpu-temp0');
    if (!temperature) {
      var firstPackageTemp = document.querySelector('[id^="cpu-temp"]');
      temperature = firstPackageTemp ? firstPackageTemp.textContent.trim() : '';
    }
    var load = metricText('.cpu.load.resize');
    var loadValue = parseFloat(load.replace(',', '.'));

    summary.querySelector('[data-metric="power"]').textContent = powerMatch ? powerMatch[1].trim() : '—';
    summary.querySelector('[data-metric="temperature"]').textContent = temperature || '—';
    summary.querySelector('[data-metric="load"]').textContent = load || '—';
    summary.querySelector('.cpu-summary-fill').style.width = Number.isFinite(loadValue) ? Math.max(0, Math.min(100, loadValue)) + '%' : '0%';
  }

  function start() {
    if (timer) return;
    update();
    timer = window.setInterval(update, 1000);
    document.addEventListener('visibilitychange', update);
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
  else start();
}());
</script>

