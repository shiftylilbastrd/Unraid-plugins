<?xml version="1.0"?>
<PLUGIN name="cpu-tile-summary" author="shiftylilbastrd" version="0.1.8" pluginURL="https://raw.githubusercontent.com/shiftylilbastrd/Unraid-plugins/main/cpu-tile-summary/cpu-tile-summary.plg" icon="icon-cpu" min="7.0.0">
  <CHANGES>
  ### 2026.11.08
  - Removes duplicate glyphs and stabilizes the collapsed summary layout.
  - Removes stray icons from the Processor header while preserving metric icons.
  - Removes a stray Docker icon from the collapsed Processor tile.
  - Publishes a clean, versioned installer URL to avoid stale cached downloads.
  - Moves the plugin into its own folder in the Unraid-plugins repository.
  - Updates the install/update URL for the new repository layout.
  - Keeps the native CPU icon and Plugins-page description.
  </CHANGES>
  <FILE Run="/bin/bash">
    <INLINE><![CDATA[
set -eu
plugdir="/boot/config/plugins/cpu-tile-summary"
mkdir -p "$plugdir"
printf '%s' '' | base64 -d > "$plugdir/cpu-tile-summary.page"
printf '%s' 'KipDUFUgVGlsZSBTdW1tYXJ5KioKClNob3dzIGxpdmUgcHJvY2Vzc29yIHBvd2VyLCB0ZW1wZXJhdHVyZSwgYW5kIG92ZXJhbGwgbG9hZCBpbiB0aGUgY29sbGFwc2VkIFByb2Nlc3NvciB0aWxlIGRlc2NyaXB0aW9uLiBFeHBhbmQgdGhlIHRpbGUgdG8gc2VlIHRoZSBDUFUgbW9kZWwgYW5kIGZ1bGwgZGFzaGJvYXJkIGRldGFpbHMuCg==' | base64 -d > "$plugdir/README.md"
ln -sfn "$plugdir" /usr/local/emhttp/plugins/cpu-tile-summary
    ]]></INLINE>
  </FILE>
  <FILE Run="/bin/bash" Method="remove">
    <INLINE><![CDATA[
rm -f /usr/local/emhttp/plugins/cpu-tile-summary
rm -rf /boot/config/plugins/cpu-tile-summary
    ]]></INLINE>
  </FILE>
</PLUGIN>
