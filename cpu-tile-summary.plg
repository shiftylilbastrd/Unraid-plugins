<?xml version="1.0"?>
<PLUGIN name="cpu-tile-summary" author="shiftylilbastrd" version="0.1.1" pluginURL="https://raw.githubusercontent.com/shiftylilbastrd/Unraid-Dashboard/main/cpu-tile-summary.plg" min="7.0.0">
  <CHANGES>
  ### 2026.11.08
  - Replaces the Processor description while the existing tile is collapsed.
  - Reuses native Dashboard power, temperature, and load values.
  </CHANGES>
  <FILE Run="/bin/bash">
    <INLINE><![CDATA[
set -eu
plugdir="/boot/config/plugins/cpu-tile-summary"
mkdir -p "$plugdir"
printf '%s' '' | base64 -d > "$plugdir/cpu-tile-summary.page"
ln -sfn "$plugdir" /usr/local/emhttp/plugins/cpu-tile-summary
    ]]></INLINE>
  </FILE>
  <FILE Run="/bin/bash" Method="remove">
    <INLINE><![CDATA[
rm -f /usr/local/emhttp/plugins/cpu-tile-summary
rm -rf /boot/config/plugins/cpu-tile-summary
    ]]></INLINE>
  </FILE>
</PLUGIN>