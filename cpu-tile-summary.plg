<?xml version="1.0"?>
<PLUGIN name="cpu-tile-summary" author="shiftylilbastrd" version="0.1.3" pluginURL="https://raw.githubusercontent.com/shiftylilbastrd/Unraid-Dashboard/main/cpu-tile-summary.plg" icon="icon-cpu" min="7.0.0">
  <CHANGES>
  ### 2026.11.08
  - Adds a CPU icon and a clear title and description in the Plugins list.
  - Uses the Processor tile's native power and temperature icons.
  - Replaces the Processor description while the existing tile is collapsed.
  </CHANGES>
  <FILE Run="/bin/bash">
    <INLINE><![CDATA[
set -eu
plugdir="/boot/config/plugins/cpu-tile-summary"
mkdir -p "$plugdir"
printf '%s' '' | base64 -d > "$plugdir/cpu-tile-summary.page"
printf '%s' 'KipDUFUgVGlsZSBTdW1tYXJ5KioKClNob3dzIGxpdmUgcHJvY2Vzc29yIHBvd2VyLCB0ZW1wZXJhdHVyZSwgYW5kIG92ZXJhbGwgbG9hZCBpbiB0aGUgY29sbGFwc2VkIFByb2Nlc3NvciB0aWxlIGRlc2NyaXB0aW9uLiBFeHBhbmQgdGhlIHRpbGUgdG8gc2VlIHRoZSBDUFUgbW9kZWwgYW5kIGZ1bGwgZGFzaGJvYXJkIGRldGFpbHMuCg==' | base64 -d > "$plugdir/README.md"
ln -sfn "$plugdir" /usr/local/emhttp/plugins/cpu-tile-summary
    ]]></INLINE>
  </FILE>
  <FILE Run="/bin/bash" Method="remove">
    <INLINE><![CDATA[
rm -f /usr/local/emhttp/plugins/cpu-tile-summary
rm -rf /boot/config/plugins/cpu-tile-summary
    ]]></INLINE>
  </FILE>
</PLUGIN>