<script>
(function(){
  function put(selector,value,digits){var n=Number(value);var s=(value===null||value===undefined||value===''||!Number.isFinite(n))?'--':(digits===undefined?String(n):n.toFixed(digits));document.querySelectorAll(selector).forEach(function(e){e.textContent=s;});}
  function txt(selector,value){document.querySelectorAll(selector).forEach(function(e){e.textContent=value;});}
  function clear(){['.cpcdash-power','.cpcdash-temp','.cpcdash-load','.cpcdash-v12','.cpcdash-p12','.cpcdash-v5','.cpcdash-p5','.cpcdash-v33','.cpcdash-p33','.cpcdash-vrm','.cpcdash-case','.cpcdash-fan','.cpcdash-eff','.cpcdash-vin','.cpcdash-pin'].forEach(function(s){put(s,null);});}
  function refresh(){ $.getJSON('/plugins/corsairpsucenter/api.php?action=status',function(d){
    if(!d||!d.connected){txt('.cpcdash-model','No PSU detected');clear();return;}
    txt('.cpcdash-model',d.model||'Corsair PSU');put('.cpcdash-power',d.power_out,0);put('.cpcdash-temp',d.temp_vrm,0);put('.cpcdash-load',d.load_pct,0);
    put('.cpcdash-v12',d.v_12,2);put('.cpcdash-p12',d.p_12,0);put('.cpcdash-v5',d.v_5,2);put('.cpcdash-p5',d.p_5,0);put('.cpcdash-v33',d.v_33,2);put('.cpcdash-p33',d.p_33,0);
    put('.cpcdash-vrm',d.temp_vrm,1);put('.cpcdash-case',d.temp_case,1);put('.cpcdash-fan',d.fan_rpm,0);put('.cpcdash-eff',d.efficiency,1);put('.cpcdash-vin',d.v_in,0);put('.cpcdash-pin',d.power_in,0);
  }).fail(function(){txt('.cpcdash-model','PSU status unavailable');});}
  refresh();window.setInterval(refresh,2000);
})();
</script>
