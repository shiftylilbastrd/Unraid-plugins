<style>.cpcdash-railhead { text-decoration: underline; }</style>
<script>
(function(){
  function put(selector,value,digits){
    var n=Number(value);
    var result=(value===null||value===undefined||value===''||!Number.isFinite(n))?'--':(digits===undefined?String(n):n.toFixed(digits));
    document.querySelectorAll(selector).forEach(function(el){el.textContent=result;});
  }
  function text(selector,value){document.querySelectorAll(selector).forEach(function(el){el.textContent=value;});}
  function clear(){
    ['.cpcdash-power','.cpcdash-temp','.cpcdash-load','.cpcdash-l12','.cpcdash-p12',
     '.cpcdash-l5','.cpcdash-p5','.cpcdash-l33','.cpcdash-p33','.cpcdash-vrm',
     '.cpcdash-case','.cpcdash-fan','.cpcdash-eff','.cpcdash-vin','.cpcdash-pin',
     '.cpcdash-capacity'].forEach(function(s){put(s,null);});
    text('.cpcdash-model','No PSU detected');
  }
  function railLoad(power,capacity,selector){
    if(power===null||capacity===null||!Number.isFinite(Number(power))||
       !Number.isFinite(Number(capacity))||Number(capacity)<=0) put(selector,null);
    else put(selector,Number(power)/Number(capacity)*100,0);
  }
  function refresh(){
    $.getJSON('/plugins/corsairpsucenter/api.php?action=status',function(data){
      if(!data||!data.connected){clear();return;}
      text('.cpcdash-model',data.model||'Corsair PSU');put('.cpcdash-capacity',data.capacity,0);
      put('.cpcdash-power',data.power_out,0);put('.cpcdash-temp',data.temp_vrm,0);put('.cpcdash-load',data.load_pct,0);
      put('.cpcdash-p12',data.p_12,0);railLoad(data.p_12,data.capacity,'.cpcdash-l12');
      put('.cpcdash-p5',data.p_5,1);railLoad(data.p_5,data.capacity,'.cpcdash-l5');
      put('.cpcdash-p33',data.p_33,1);railLoad(data.p_33,data.capacity,'.cpcdash-l33');
      put('.cpcdash-vrm',data.temp_vrm,1);put('.cpcdash-case',data.temp_case,1);
      put('.cpcdash-fan',data.fan_rpm,0);put('.cpcdash-eff',data.efficiency,1);
      put('.cpcdash-vin',data.v_in,0);put('.cpcdash-pin',data.power_in,0);
    }).fail(function(){text('.cpcdash-model','PSU status unavailable');});
  }
  refresh();window.setInterval(refresh,2000);
})();
</script>
