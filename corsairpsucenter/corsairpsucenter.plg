<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name "corsairpsucenter">
<!ENTITY author "shiftylilbastrd">
<!ENTITY version "2026.11.08.2">
<!ENTITY launch "CorsairPSUCenter">
<!ENTITY gitURL "https://raw.githubusercontent.com/shiftylilbastrd/Unraid-plugins/main/corsairpsucenter">
<!ENTITY pluginURL "&gitURL;/&name;.plg">
<!ENTITY source "https://raw.githubusercontent.com/racoutlaw/corsair-psu-center/main/archive/corsairpsucenter-2026.09.26-x86_64.txz">
<!ENTITY md5 "62174c06f6c842db3fb5bb05656a3dee">
<!ENTITY plugdir "/boot/config/plugins/&name;">
]>
<PLUGIN name="&name;" author="&author;" version="&version;" pluginURL="&pluginURL;" launch="&launch;" icon="bolt" min="6.12.0" support="https://github.com/racoutlaw/corsair-psu-center">
<CHANGES>###2026.11.08.2
- Labels the collapsed power and temperature readings for clarity.
- Combines Corsair PSU Center auto-detection and monitoring page with a native Unraid Dashboard tile.
- Dashboard tile shows output power, temperature, load, rail readings, fan speed, efficiency, and input details.
- Reuses the plugin's kernel hwmon status API for telemetry.
- Based on Corsair PSU Center by racoutlaw (GPL-2.0).</CHANGES>
<FILE Run="/bin/bash"><INLINE><![CDATA[
shopt -s nullglob
for pidfile in /var/run/corsairpsucenter-fand.pid /var/run/corsairpsucenter-energyd.pid; do
  if [ -f "$pidfile" ]; then kill "$(cat "$pidfile")" 2>/dev/null || true; rm -f "$pidfile"; fi
done
for pkg in /var/lib/pkgtools/packages/corsairpsucenter-*; do
  [ -e "$pkg" ] && removepkg "$(basename "$pkg")" >/dev/null 2>&1 || true
done
exit 0
]]></INLINE></FILE>
<FILE Name="&plugdir;/corsairpsucenter-2026.09.26-x86_64.txz" Run="upgradepkg --install-new"><URL>&source;</URL><MD5>&md5;</MD5></FILE>
<FILE Run="/bin/bash"><INLINE><![CDATA[
set -eu
mkdir -p /usr/local/emhttp/plugins/corsairpsucenter
printf '%s' '' | base64 -d > /usr/local/emhttp/plugins/corsairpsucenter/statusMovable.page
chmod 644 /usr/local/emhttp/plugins/corsairpsucenter/statusMovable.page
sed -i 's/^Menu="Tasks:75"$/Menu="Utilities"/; s/^Title="Corsair PSU"$/Title="Corsair PSU Center"/' /usr/local/emhttp/plugins/corsairpsucenter/CorsairPSUCenter.page
chmod 755 /usr/local/emhttp/plugins/corsairpsucenter/fand.sh 2>/dev/null || true
if [ -f /boot/config/plugins/corsairpsucenter/settings.cfg ] && grep -q 'mode="curve"' /boot/config/plugins/corsairpsucenter/settings.cfg; then
  setsid /usr/local/emhttp/plugins/corsairpsucenter/fand.sh >/dev/null 2>&1 < /dev/null &
fi
setsid /usr/bin/php /usr/local/emhttp/plugins/corsairpsucenter/energyd.php >/dev/null 2>&1 < /dev/null &
echo "Corsair PSU Center with Dashboard tile installed."
]]></INLINE></FILE>
<FILE Run="/bin/bash" Method="remove"><INLINE><![CDATA[
shopt -s nullglob
for pidfile in /var/run/corsairpsucenter-fand.pid /var/run/corsairpsucenter-energyd.pid; do
  if [ -f "$pidfile" ]; then kill "$(cat "$pidfile")" 2>/dev/null || true; rm -f "$pidfile"; fi
done
for pkg in /var/lib/pkgtools/packages/corsairpsucenter-*; do
  [ -e "$pkg" ] && removepkg "$(basename "$pkg")" >/dev/null 2>&1 || true
done
rm -rf /usr/local/emhttp/plugins/corsairpsucenter
rm -f /boot/config/plugins/corsairpsucenter/*.txz /boot/config/plugins/corsairpsucenter.plg
echo "Corsair PSU Center removed. Saved settings and energy history remain."
]]></INLINE></FILE>
</PLUGIN>